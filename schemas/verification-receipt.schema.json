{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ciprian-LocalPulse/CIGP-Protocol/schemas/verification-receipt.schema.json",
  "title": "CIGP Verification Receipt",
  "description": "A bounded record of checks performed by an independent CIGP verifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cigp_version",
    "receipt_version",
    "subject",
    "verifier",
    "verified_at",
    "status",
    "checks"
  ],
  "properties": {
    "cigp_version": { "const": "0.1" },
    "receipt_version": { "const": "0.1" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round_id", "round_hash"],
      "properties": {
        "round_id": { "type": "string", "minLength": 1 },
        "round_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version"],
      "properties": {
        "implementation": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "profile": { "type": "string" }
      }
    },
    "verified_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["VALID", "INVALID", "INCONCLUSIVE"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
          "detail": { "type": "string" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
