{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CIGP Audit Event",
  "type": "object",
  "required": ["round_id", "previous_hash", "event_hash", "timestamp"],
  "properties": {
    "round_id": { "type": "string", "minLength": 1 },
    "previous_hash": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64}|sha256:genesis)$" },
    "event_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
