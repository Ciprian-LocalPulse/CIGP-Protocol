{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cigp-protocol.org/schemas/game-manifest.schema.json",
  "title": "CIGP GameManifest",
  "description": "Normative schema for a published game manifest, as defined in spec/CIGP-0.1.md, Section 6.",
  "type": "object",
  "required": ["cigp_version", "game", "rng", "mathematics", "paytable", "logic", "configuration", "jurisdiction", "certification"],
  "properties": {
    "cigp_version": { "type": "string", "const": "0.1" },
    "game": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "rng": {
      "type": "object",
      "required": ["algorithm", "version"],
      "properties": {
        "algorithm": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "mathematics": {
      "type": "object",
      "required": ["theoretical_rtp", "volatility"],
      "properties": {
        "theoretical_rtp": { "type": "number", "minimum": 0, "maximum": 1 },
        "volatility": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] }
      }
    },
    "paytable": {
      "type": "object",
      "required": ["hash"],
      "properties": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
    },
    "logic": {
      "type": "object",
      "required": ["hash"],
      "properties": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
    },
    "configuration": {
      "type": "object",
      "required": ["hash"],
      "properties": { "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
    },
    "jurisdiction": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z]{2}$" },
      "minItems": 0
    },
    "certification": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["UNVERIFIED", "SELF_ATTESTED", "LAB_CERTIFIED"] },
        "laboratory": { "type": "string" },
        "certificate_reference": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
