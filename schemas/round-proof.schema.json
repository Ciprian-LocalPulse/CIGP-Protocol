{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cigp-protocol.org/schemas/round-proof.schema.json",
  "title": "CIGP RoundProof",
  "description": "Normative schema for a single CIGP round proof object, as defined in spec/CIGP-0.1.md, Section 5.",
  "type": "object",
  "required": [
    "cigp_version",
    "round_id",
    "operator_id",
    "game_id",
    "game_version",
    "bet",
    "server_commitment",
    "client_seed",
    "nonce",
    "rng",
    "mapping",
    "outcome",
    "paytable_hash",
    "game_logic_hash",
    "configuration_hash",
    "payout",
    "previous_round_hash",
    "round_hash",
    "signature",
    "timestamp"
  ],
  "properties": {
    "cigp_version": { "type": "string", "const": "0.1" },
    "round_id": { "type": "string", "minLength": 1 },
    "operator_id": { "type": "string", "minLength": 1 },
    "game_id": { "type": "string", "minLength": 1 },
    "game_version": { "type": "string", "minLength": 1 },
    "server_commitment": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "server_seed": { "type": ["string", "null"] },
    "client_seed": { "type": "string", "minLength": 1 },
    "nonce": { "type": "integer", "minimum": 0 },
    "rng": {
      "type": "object",
      "required": ["algorithm", "version", "output"],
      "properties": {
        "algorithm": { "type": "string" },
        "version": { "type": "string" },
        "output": { "type": "string" }
      }
    },
    "mapping": {
      "type": "object",
      "required": ["algorithm", "version", "parameters_hash"],
      "properties": {
        "algorithm": { "type": "string" },
        "version": { "type": "string" },
        "parameters_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["symbols"],
      "properties": {
        "symbols": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "paytable_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "game_logic_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "configuration_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "previous_round_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "round_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signature": { "type": "string", "pattern": "^[a-f0-9]{128}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "bet": {
      "type": "object",
      "required": ["currency", "minor_units"],
      "properties": {
        "currency": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "minItems": 3, "maxItems": 3 },
        "minor_units": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "payout": {
      "type": "object",
      "required": ["currency", "minor_units"],
      "properties": {
        "currency": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 }, "minItems": 3, "maxItems": 3 },
        "minor_units": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
